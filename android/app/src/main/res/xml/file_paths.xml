<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches newCameraUri(): cacheDir/assistant_images, handed to the camera via FileProvider. -->
    <cache-path name="assistant_images" path="assistant_images/" />
    <!-- Matches UpdateInstaller: the downloaded APK in externalFilesDir/Download, for the installer. -->
    <external-files-path name="app_downloads" path="Download/" />
</paths>
